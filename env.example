# Tailscale auth key for the rig's three nodes.
# Admin console > Settings > Keys > Generate auth key
#   Reusable:  yes (three containers share it)
#   Ephemeral: yes (nodes disappear from the tailnet when you stop the compose stack)
#   Tags:      optional, but set one here if your ACL requires it
TS_AUTHKEY=tskey-auth-xxxxxxxxxxxx
