# Auth key Tailscale per i tre nodi del banco.
# Admin console > Settings > Keys > Generate auth key
#   Reusable:  si (la usano tre container)
#   Ephemeral: si (i nodi spariscono dalla tailnet quando fermi il compose)
#   Tags:      facoltativo, ma se la tua ACL richiede tag mettine uno qui
TS_AUTHKEY=tskey-auth-xxxxxxxxxxxx
